# ==========================================
# Student Deadline Radar - Environment Config
# ==========================================

# Server Port
PORT=8000

# Environment Mode
NODE_ENV=production

# SQLite Database File Path (Leave commented for default ./backend/deadlines.db)
# DATABASE_PATH=/app/data/deadlines.db

# Allowed CORS Origins (comma-separated or '*' for any)
CORS_ORIGIN=*

# Gemini 1.5 Flash API Key for AI email notice parsing (optional, rule-based fallback active)
GEMINI_API_KEY=

# Telegram Alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Frontend Backend Target (only needed if deploying frontend separately, e.g. on Vercel)
# VITE_API_URL=https://your-backend.onrender.com
