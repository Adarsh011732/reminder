# ==========================================
# Student Deadline Radar - Environment Config
# ==========================================

# Server Port
PORT=8000

# Environment Mode
NODE_ENV=production

# SQLite Database File Path (Leave commented for default ./backend/deadlines.db)
# DATABASE_PATH=/app/data/deadlines.db

# Session cookie signing secret (min 32 chars) - REQUIRED for stable sessions in production.
# Multi-instance/serverless deployments MUST set this or logins will not persist across instances.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Allowed CORS Origins (comma-separated, exact match).
# - Unset (recommended for the standard single-domain Vercel/Vite-proxy setup): same-origin only.
# - "https://a.example,https://b.example": exact allowlist with credentials, for split deployments.
# - "*" re-enables wildcard CORS but credentials are NEVER combined with it.
# CORS_ORIGIN=https://deadline-radar.vercel.app

# Gemini Flash API Key for AI email notice parsing (optional, rule-based fallback active)
GEMINI_API_KEY=
# Model id is configurable so future model retirements don't need code changes
GEMINI_MODEL=gemini-2.5-flash
# Second model tried automatically when the primary is retired/missing
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# Telegram Alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Frontend Backend Target (only needed if deploying frontend separately, e.g. on Vercel)
# VITE_API_URL=https://your-backend.onrender.com
