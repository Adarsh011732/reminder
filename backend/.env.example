# Port to bind the Node.js Express server (default: 8000)
PORT=8000

# Environment mode ('production' or 'development')
NODE_ENV=production

# Database path (optional: custom path, e.g. /data/deadlines.db for persistent Docker / Render disks)
# DATABASE_PATH=./deadlines.db

# Allowed CORS origins (comma-separated or '*' for all)
CORS_ORIGIN=*

# Gemini 1.5 Flash API Key for AI email notice parsing (optional, rule-based fallback active)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Telegram Bot Alert Configuration (optional)
# Create a bot with @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
